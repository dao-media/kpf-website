# Dedicated local ports — see scripts/local-ports.env
# WordPress admin: http://localhost:8888/wp-admin
# Faust frontend:  http://localhost:3010

# Your WordPress site URL (wp-env)
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:8888

# Plugin secret found in WordPress Settings → Faust (synced by scripts/wp-bootstrap.sh)
FAUST_SECRET_KEY=

# Optional GA4 / GTM. Events still push to window.dataLayer without these.
# Mark donate_clicked and generate_lead as key events in GA4.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=