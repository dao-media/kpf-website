# Dedicated local ports for the Kevin Popke Foundation stack.
# Sourced by scripts/wp-bootstrap.sh and documented in README.md.
#
# Keep these unique across machines that also run other Next.js apps
# (port 3000 is commonly taken — e.g. LinkedWin).

KPF_WP_PORT=8888
KPF_FRONTEND_PORT=3010
KPF_WP_URL=http://localhost:8888
KPF_FRONTEND_URL=http://localhost:3010
